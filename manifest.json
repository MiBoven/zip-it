{
  "name": "Zip-It",
  "short_name": "Zip-It",
  "description": "The Zipper for your Files — pack and unpack ZIP, TAR and GZ archives with password protection, entirely in your browser.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#131313",
  "background_color": "#131313",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icons/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/zip": [".zip"],
        "application/gzip": [".gz", ".tgz"],
        "application/x-tar": [".tar"]
      }
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["*/*"] }
      ]
    }
  }
}
